# Copiez ce fichier en .env et remplissez-le (le .env n'est jamais publie)
# Compte Gmail qui envoie les e-mails (a vous et la confirmation au client)
EMAIL_USER=votre.email@gmail.com
# Mot de passe d'application Gmail : https://myaccount.google.com/apppasswords
EMAIL_PASS=mot_de_passe_application
# Adresse qui recoit les messages et commandes
EMAIL_TO=votre.email@gmail.com
